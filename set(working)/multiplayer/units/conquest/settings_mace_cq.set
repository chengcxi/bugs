(define "squad_4vehicle2"
	("generic_v_conquest" t(%side %period) r(%min_stage) mr(%max_stage) cw(%cw) cp(%cp))
	{content "%vehicle1 ( mp/%side/%period/%crew1 mp/%side/%period/%crew2 ) %vehicle2 ( mp/%side/%period/%crew3 mp/%side/%period/%crew4 ) %vehicle3 ( mp/%side/%period/%crew5 mp/%side/%period/%crew6 ) %vehicle4 ( mp/%side/%period/%crew7 mp/%side/%period/%crew8 )"}
