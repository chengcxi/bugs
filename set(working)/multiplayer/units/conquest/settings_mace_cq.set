(define "towed_gun"
    ("generic_v_conquest" t(%side %period) r(%min_stage) mr(%max_stage) cw(%cw) cp(%cp)) ;//h
    {content "%vehicle ( mp/%side/%period/%crew_v1 mp/%side/%period/%crew_v2) %cannon ( mp/%side/%period/%crew_c )"}
    {button "vehicles"}
)

; vehicle with 2 types of crew mace for french vehicles
(define "vehicle2_mace"
	("generic_v_conquest" t(%side %period %tag) r(%min_stage) mr(%max_stage) cw(%cw) cp(%cp))
	{content "* ( mp/%side/%period/%crew1 mp/%side/%period/%crew2 )"}
	{button "vehicles"}
)
(define "squad_3_4_vehicle3_conquest"
    ("generic_v_conquest" t(%side %period) r(%min_stage) mr(%max_stage) cw(%cw) cp(%cp)) ;//h
    {content "%vehicle1 ( mp/%side/%period/%crew1 mp/%side/%period/%crew2 mp/%side/%period/%crew3 ) %vehicle2 ( mp/%side/%period/%crew4 mp/%side/%period/%crew5 mp/%side/%period/%crew6 mp/%side/%period/%crew7 ) %vehicle3 ( mp/%side/%period/%crew8 mp/%side/%period/%crew9 mp/%side/%period/%crew10)"}
	{button "vehicles"}
)

(define "squad_4_3_vehicle3_conquest"
    ("generic_v_conquest" t(%side %period) r(%min_stage) mr(%max_stage) cw(%cw) cp(%cp)) ;//h
    {content "%vehicle1 ( mp/%side/%period/%crew1 mp/%side/%period/%crew2 mp/%side/%period/%crew3 mp/%side/%period/%crew4 ) %vehicle2 ( mp/%side/%period/%crew5 mp/%side/%period/%crew6 mp/%side/%period/%crew7 mp/%side/%period/%crew8 ) %vehicle3 ( mp/%side/%period/%crew9 mp/%side/%period/%crew10 mp/%side/%period/%crew11)"}
	{button "vehicles"}
)
;// For the swedish units:

(define "squad_with2types_1vehicle_conquest"
	{"%name(%side)"
		{charge {delay 0}{interval 0}}
		{content "mp/%side/%period/%c1 mp/%side/%period/%c2 %vehicle ( mp/%side/%period/%crew1 mp/%side/%period/%crew2 ) "}
		{tags "conquest conquestonly %side %period"}
		{level 1}
		{cost 0}
		{research_stage %min_stage}
		{research_stage_max %max_stage}
		{squad_cost_factor 1}
		{button "inf1"}
	}
)

