	{content "%vehicle1 ( mp/%side/%period/%crew1 mp/%side/%period/%crew2 ) %vehicle2 ( mp/%side/%period/%crew3 mp/%side/%period/%crew4 ) %vehicle3 ( mp/%side/%period/%crew5 mp/%side/%period/%crew6 )"}
	{button "vehicles"}
)

