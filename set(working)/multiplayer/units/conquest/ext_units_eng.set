; File: 		ext_units_eng.set
; Catalog: 		set\multiplayer\units\conquest
; Created by: 	Max Drechsler
; Created:		x.xx.xxxx
; Modify by:	Max Drechsler
; Modify:		02.09.2026
; Version:		x.x
; DSL:			GEM ENGINE 2 Gates of Hell
; Description: 


;========================================================================== ARM ==========================================================================
; SDL GEM ENGINE 2
; "vs(...)" corresponds to a define found in the settings down this file
; v() If squad is motorised, this is the vehicle that carries the men.
; cd() corresponds to countdown delay to spawn the unit once battle begins
; ci() corresponds to cooldown to buy unit once again
; side() corresponds to side (faction)
; n() corresponds to number of crew in the unit, the type of crew is defined in the "vs"
; g() corresponds to group, which is for classification and collective cooldowns
; sc() corresponds to the score given to the player upon killing this unit
; b() corresponds to the button where this unit is located in the menus
; i() corresponds to icon order
; cw() corresponds to capture weight for flags
; cp() corresponds to CP, that is, the value that units have that fill up how many troops can be fielded
; {cost -} corresponds to MP cost of the unit
; {level 6} Corresponds to player XP progress in player profile from steam
; {research_stage 4} corresponds to research stage of dynamic campaign
; {squad_cost_factor 1} - adds the cost of the crew / the cost of the squad members with this factor
; scf() - adds the cost of the crew / the cost of the squad members with this factor
; {score_factor 0.05} - when the unit is killed, it will have an impact on the MP score of 0.05*Cost. This only works if {squad_cost_factor 1}. With a fixed cost for the squad such (= scf 0), you need to adjust the scores of the individual units manually
; {score 20} - when the unit is killed, it will have an impact on the MP score of 20
; {round_multiple 5.0} - the cost of the unit is rounded up or down to this multiple
; ;//	{tags "limit1"}

;//	Ящик с боеприпасами - 50 AP
;//	Ящик фортификаторов - 300 AP

;//	Тележка малая - 75 AP
;//	Тележка средняя - 150 AP
;//	Тележка большая - 325 AP

;//	Грузовик малый - 300 AP
;//	Грузовик средний - 425 AP
;//	Грузовик тяжелый - 625 AP
;//	Грузовик сверхтяжелый - 750 AP

;//	Грузовик легкий инженерный - 100 AP
;//	Грузовик средний инженерный - 225 AP

;//	Грузовик снабжения оружием - 800 AP

;//	Машина полевого ремонта - 550 AP

;//	Бензовоз - 500 AP


;////////////////// INSTRUCTIONS //////////////////
;Buttons go as follows, displayed in-game in this order:

; inf1       - infantry squads
; inf2       - infantry single units
; empl       - Emplacements, AA, AT, Mortars, Howitzers
; vehicles   - vehicles, armoured cars, supplies
; tanks      - main battle tanks, TDs, SPGs
; doctrine   - specific doctrine setups

; TEMP: Note all levels have been brought down to 1 to remove unit locks.
; Squads currently have an MP cost of 0 - their cost is currently calculated as the sum of their soldiers cost, see inf_ger.set
; Check ../settings.set for syntax instructions!!
; unit limits per game are not defined here but in gamemode presets

;user defined set tags that should be featured on units:
;all artillery heavyart cannon mediumcan heavycan light medium heavy infantry supply
;these tags allow player to disable certain sets for custom setups like "no heavy artillery" 
;//////////////////////////////////////////////////

	{"main_ARM(eng)"
		("squad_with1types_conquest" side(ger) period(late) min_stage(0) max_stage(99) c1(officer:1)
		)
	}
	
	{"conquest_blank"
		("vehicle"  side(eng) period(mid) min_stage(1) max_stage(99) crew(tankman:0) cw(0) cp(0))
	{cost 0} 
	{not_for_player_sale 1}
}

;============================================================= ENG Modded infantry ========================================================
;;------------------------------------------------------------ ENG Modded infantry squads -------------------------------------------------

("squad_with1types_conquest" 
	side(eng) period(mid) 
	min_stage(3) max_stage(99) 
	name(single_officer) 
		c1(plt_com:1)
)

("squad_with4types_conquest" 
	side(eng) period(mid) 
	min_stage(3) max_stage(99) 
	name(squad_officer_con) 
		c1(plt_com:1) 
			c2(plt_sgt:1) 
				c3(batman:1) 
					c4(rifle:1)
)

{"squad_officer_carrier_con"
	("squad_vehicle3" 
	side(eng) period(mid) 
	min_stage(3) max_stage(99) 
	vehicle(universal_carrier_mk2_boys) 
		crew1(mot_scout_driver:1) 
			crew2(mot_scout_gunner:1) 
				crew3(plt_com:1) 
	cw(2) cp(2)
	)
}

{"squad_officer_m5a1_halftrack_con"
	("squad_vehicle6" 
		side(eng) period(late) 
		min_stage(9) max_stage(99) 
		vehicle(m5a1_halftrack) 
			crew1(driver:1) 
				crew2(rifle:1) 
					crew3(coy_com:1) 
						crew4(coy_sgt_maj:1) 
							crew5(batman_smg:1) 
								crew6(rifle:2) 
		cw(3) cp(2)
	)
}

