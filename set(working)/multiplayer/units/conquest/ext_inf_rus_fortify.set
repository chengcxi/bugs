;------------ (1944-1945) squad_soviet_fortifiers
(define "squad_soviet_fortifiers" ; tier 3
	{tags "%period %side %level infantry man"}	
	{cp 0.0}	
	{basic}	
	{breed}	
	{level %lv}
	{cw 0.5}	
	;{cost %cost}
	{score_factor 0.05}
)
		{"mp/rus/early/soviet_fortifier_ls"							("squad_soviet_fortifiers"								period(early) 	side(rus) 		lvl2()	r(99) rm(99)) 		{cp 4.0}		{cost 525.0}} 
		{"mp/rus/early/soviet_fortifier_private"					("squad_soviet_fortifiers"								period(early) 	side(rus) 		lv1l()	r(99) rm(99)) 		{cp 4.0}		{cost 475.0}}

