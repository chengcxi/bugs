	{cp 0.0}	
	{basic}	
	{breed}	
	{level %lv}
	{cw 0.5}	
	;{cost %cost}
	{score_factor 0.05}
)
		{"mp/rus/late/soviet_fortifier_ls"							("squad_soviet_fortifiers_late"							period(late) 	side(rus) 		lvl2()	r(99) rm(99))		{cp 4.0}		{cost 825.0}}
		{"mp/rus/late/soviet_fortifier_private"						("squad_soviet_fortifiers_late"							period(late) 	side(rus) 		lvl1()	r(99) rm(99)) 		{cp 4.0}		{cost 775.0}}

