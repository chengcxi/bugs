;SDL
;// CP + Scores + CW

;////////////////// INSTRUCTIONS //////////////////
; In this file onee configures the humans which are spawned in vehicles or squads
; The humans have a CP and cost associated with them which collectively add up for the final squad value
; Check ../settings.set for syntax instructions!!
;//////////////////////////////////////////////////


		{"mp/usa/late/arm_usa_engineer_heavy"				("inf_usa_arm_usa_engineer_heavy" 			side(usa) period(late) cost(50.0))}
		{"mp/usa/late/arm_usa_artilleryman_heavy"			("inf_usa_arm_usa_artilleryman_heavy" 		side(usa) period(late) cost(15.0))}
		