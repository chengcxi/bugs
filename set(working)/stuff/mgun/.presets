(include "\set\small_firearms_accuracy.inc")

;/*=========================*/

(define "burst_short"
	{burst
        {short 4 1}      ; 3–5 выстрелов на дальних дистанциях (минимум 4 с учётом логики: при отклонении -1 будет 3, но это нижний предел; чтобы строго гарантировать минимум 4, см. примечание ниже)
        {long 6 2}       ; 4–8 выстрелов на ближних дистанциях (минимум 4)
        {rangeKoef 0.5}  ; макс. дистанция длинной очереди = 50 % от aimRange
	}
)

(define "burst_medium"
	{burst
        {short 8 1}      ; 7–9 выстрелов на дальних дистанциях (минимум 7, но см. корректировку ниже для строгого минимума 8)
        {long 10 2}      ; 8–12 выстрелов на ближних дистанциях (минимум 8)
        {rangeKoef 0.5}
	}
)

(define "burst_long"						
	{burst
        {short 12 1}     ; 11–13 выстрелов на дальних дистанциях (минимум 11, но см. корректировку ниже для строгого минимума 12)
        {long 14 2}      ; 12–16 выстрелов на ближних дистанциях (минимум 12)
        {rangeKoef 0.5}
	}
)

(define "burst_stand"
	{burst
        {short 10 4}      ; 6–14 выстрелов
        {long 20 5}     	; 15–25 выстрелов
        {rangeKoef 0.75}
	}
)

(define "burst_aa"
	{burst
		{short 12 0}
		{long 25 3}
		{rangeKoef 0.5}
	}
)

(define "burst_aa_quad"
	{burst
		{short 30 0}
		{long 150 3}
		{rangeKoef 0.5}
	}
)

