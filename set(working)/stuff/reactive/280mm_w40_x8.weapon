	{calibre 280}

	("rocket_artillery")

	{spreading
		{radiusTable
			; {0 0}
			; {100 10}
			; {200 20}
			; {249.99 26} ;// max range
			; {250 100}
			; {310 200}
			{0 0}
			{200 20}
			{400 40}
			{499.9 52} ;// max range
			{505 200}
