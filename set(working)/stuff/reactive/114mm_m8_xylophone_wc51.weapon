; US calliope Rocket Artillery
;=========================================


{from "pattern reactive"		; "M4 calliope"
	{filling "ammo 114mm_m8" 8}
	{fireSound "reactive/katy_burst/"}
	{calibre 114}
	("rocket_artillery")


	{spreading
		{radiusTable
;//			{0 0}
;//			{100 10}
;//			{200 20}
;//			{269.99 25} ;// max range, 3.7km
;//			{270 100}
;//			{290 200}
			{0 0}
			{200 20}
			{400 40}
			{539.9 50} ;// max range
			{600 200}
		}
	}

	{parameters "he2"
		{range 290 290} 
		{spreading
			{radiusTable
;//			{0 0}
;//			{100 10}
;//			{200 20}
;//			{269.99 25} ;// max range, 3.7km
;//			{270 100}
;//			{290 200}
			{0 0}
			{200 20}
			{400 40}
			{539.9 50} ;// max range
			{600 200}
			}
		}
	}

	{parameters "heat"
	    {projectileDamageTable {0 100}}
		{cursorReloading "gun_heat"}
		("armor health" damage(300))
	}
	
	{burst
		{min 8}
		{noaiming}
	}
;//	{gravity 2.7}
	{gravity 1.5}	

	{minRange 50}
;//	{range 270 270} ;//3.7km
	{range 540 540} ;//3.7km
	("velocity" mps(270))
;//	("reload time" seconds(180))
	("reload time" seconds(70))
	("fire rate" rpm(120)) ;// one rocket every 0.5s in "ripple fire". 30s to fire full salvo
}