{from "pattern reactive"		; "pz38h_w40"
	{filling "ammo BR_240SP" 2}
	{fireSound "reactive/nebel_burst/"}
	{calibre 250}

	{foresight "foresight"}

	("rocket_artillery")

	{spreading
		{radiusTable
			{0 0}
			{100 10}
			{200 20}
			{250.99 30} ;// max range
			{270 100}
			{285 200}
		}
	}

	{burst 
		{min 1}
		{noaiming}
	}
	{gravity 0.5}

	{minRange 75}
	{maxRange 250} ;//4,55km
	("velocity" mps(100))
	("reload time" seconds(180))
}
