; Rules for when enemy units are revealed in fog of war to the user/player
; after they generate a sound signal and are detected by friendly units
; {meters - seconds staying visible}
; Specific classes need to be at the top, generic ones later

{detect

; // howitzer artillery
;//------------------------------ detect_artillery								
	{"detect_artillery" "attack"
;//		{0		0}																	;ARm-
		{0		0}																	;ARm+
	}
	{"detect_artillery" "visible"
		{0		30}
	}
	
;//------------------------------ detect_super_heavy_artillery								
	{"detect_super_heavy_artillery" "attack"
;//		{0		0}																	;ARm-
		{0		25}																	;ARm+
	}
	{"detect_super_heavy_artillery" "visible"
		{0		40}
	}	

;//------------------------------ detect_artillery_muzzle							; with Muzzle brake							
	{"detect_artillery_muzzle" "attack"
;//		{0		0}																 	;ARm-
		{0		2}																	;_muzzle +2		;120226+
	}
	{"detect_artillery_muzzle" "visible"
		{0		30}
	}	

; // small caliber artillery, mortars and support guns

	{"detect_artillery_small" "attack"
		{0		0}																	;_muzzle +0		;120226+
	}
	{"detect_artillery_small" "visible"												;_muzzle +0		;120226+
		{0		15}
	}

; // medium caliber artillery, mortars and support guns

	{"detect_artillery_medium" "attack"
		{0		0}																	;_muzzle +0		;120226+
	}
	{"detect_artillery_medium" "visible"											;_muzzle +0		;120226+
		{0		20}
	}

; // heavy caliber artillery, mortars and support guns

	{"detect_artillery_heavy" "attack"
		{0		1}																	;_muzzle +0		;120226+
	}
	{"detect_artillery_heavy" "visible"												;_muzzle +0		;120226+
		{0		25}
	}	

; // AT guns, low detectability, class advantage

;//------------------------------ detect_atgun
	{"detect_atgun" "attack"
		{0		15}
	}
	{"detect_atgun" "visible"
		{0		20}
	}
	
;//------------------------------ detect_atgun_muzzle								; with Muzzle brake
	{"detect_atgun_muzzle" "attack"													;_muzzle +2		;120226+
		{0		17}
	}
	{"detect_atgun_muzzle" "visible"												;_muzzle +0		;120226+
		{0		20}
	}

; // Small AT guns, very low detectability, class advantage

;//------------------------------ detect_atgun
	{"detect_atgun_small" "attack"
		{0		15}
	}
	{"detect_atgun_small" "visible"
		{0		20}
	}


;//------------------------------ detect_atgun_small_muzzle								; with Muzzle brake	
	{"detect_atgun_small_muzzle" "attack"
		{0		17}																		;_muzzle +2		;120226+
	}
	{"detect_atgun_small_muzzle" "visible"
		{0		20}
	}

; // AA guns and MGs, very hard to detect, linked to max autocannon range of 170m

	{"detect_cannon_aa" "attack"
		{0		15}
	}
	{"detect_cannon_aa" "visible"
		{0		15}
	}

;//------------------------------ detect_atgun_heavy
	{"detect_atgun_heavy" "attack"
		{0		20}
	}
	{"detect_atgun_heavy" "visible"
		{0		25}
	}
	
;//------------------------------ detect_atgun_superheavy
	{"detect_atgun_superheavy" "attack"
		{0		25}
	}
	{"detect_atgun_superheavy" "visible"
		{0		30}
	}

;//------------------------------ detect_atgun_superheavy
	{"detect_atgun_superheavy_forti" "attack"
		{0		15}
	}
	{"detect_atgun_superheavy_forti" "visible"
		{0		20}
	}	

; // Tanks of various shapes and forms
;//------------------------------ detect_spg
	{"detect_spg" "attack"
		{0		20}
	}
	{"detect_spg" "visible"
		{0		30}
	}
	
;//------------------------------ detect_spg_muzzle								; with Muzzle brake
	{"detect_spg_muzzle" "attack"												
		{0		22}																;_muzzle +2		;120226+
	}
	{"detect_spg_muzzle" "visible"												;_muzzle +0		;120226+
		{0		30}
	}	

;//------------------------------ detect_spg_heavy
	{"detect_spg_heavy" "attack"
		{0		25}
	}
	{"detect_spg_heavy" "visible"
		{0		35}
	}

;//------------------------------ detect_spg_heavy_muzzle						; with Muzzle brake
	{"detect_spg_heavy_muzzle" "attack"											
		{0		27}																;_muzzle +2		;120226+
	}
	{"detect_spg_heavy_muzzle" "visible"
		{0		40}
	}

	;//----------

	{"detect_tank_mg" "attack"
		{0		10}
	}
	{"detect_tank_mg" "visible"
		{0		5}
	}

	;//----------

;//------------------------------ detect_td_heavy	
	{"detect_td_heavy" "attack"
		{0		30}
	}
	{"detect_td_heavy" "visible"
		{0		40}
	}

;//------------------------------ detect_td_heavy_muzzle						; with Muzzle brake	
	{"detect_td_heavy_muzzle" "attack"											;_muzzle +2		;120226+
		{0		32}
	}
	{"detect_td_heavy_muzzle" "visible"											;_muzzle +0		;120226+
		{0		40}
	}


;//------------------------------ detect_td_light	
	{"detect_td_light" "attack"
		{0		20}
	}
	{"detect_td_light" "visible"
		{0		30}
	}
	
;//------------------------------ detect_td_light_muzzle						; with Muzzle brake	
	{"detect_td_light_muzzle" "attack"
		{0		22}																;_muzzle +2		;120226+
	}
	{"detect_td_light_muzzle" "visible"
		{0		30}
	}	

;//------------------------------ detect_td_medium
	{"detect_td_medium" "attack"
		{0		25}
	}
	{"detect_td_medium" "visible"
		{0		35}
	}

;//------------------------------ detect_td_medium_muzzle						; with Muzzle brake		
	{"detect_td_medium_muzzle" "attack"											;_muzzle +2		;120226+
		{0		27}
	}
	{"detect_td_medium_muzzle" "visible"										;_muzzle +0		;120226+
		{0		35}
	}

	;//----------

;//------------------------------ tank_heavy
	{"detect_tank_heavy" "attack"
		{0		30}
	}
	{"detect_tank_heavy" "visible"
		{0		40}
	}

;//------------------------------ detect_tank_heavy_muzzle		; with Muzzle brake	
	{"detect_tank_heavy_muzzle" "attack"						;_muzzle +2		;120226+
		{0		32}
	}
	{"detect_tank_heavy_muzzle" "visible"						;_muzzle +0		;120226+
		{0		40}
	}

;//------------------------------ detect_tank_td_super_heavy	
	{"detect_tank_td_super_heavy" "attack"						
		{0		40}
	}
	{"detect_tank_td_super_heavy" "visible"						
		{0		45}
	}
	
;//------------------------------ detect_tank_td_super_heavy_muzzle		; with Muzzle brake	
	{"detect_tank_td_super_heavy_muzzle" "attack"						;_muzzle +2		;120226+
		{0		42}
	}
	{"detect_tank_td_super_heavy_muzzle" "visible"						;_muzzle +0		;120226+
		{0		45}
	}
	
;//------------------------------ detect_tank_light	
	{"detect_tank_light" "attack"
		{0		20}
	}
	{"detect_tank_light" "visible"
		{0		30}
	}

;//------------------------------ detect_tank_light_muzzle				; with Muzzle brake	
	{"detect_tank_light_muzzle" "attack"								
		{0		22}														;_muzzle +2		;120226+
	}
	{"detect_tank_light_muzzle" "visible"
		{0		30}
	}

;//------------------------------ detect_tank_medium	
	{"detect_tank_medium" "attack"
		{0		25}
	}
	{"detect_tank_medium" "visible"
		{0		35}
	}
	
;//------------------------------ detect_tank_medium_muzzle		; with Muzzle brake	
	{"detect_tank_medium_muzzle" "attack"						
		{0		27}												;_muzzle +2		;120226+
	}
	{"detect_tank_medium_muzzle" "visible"
		{0		35}
	}


; // Generic vehicles, will use this rule if not propped

	{"vehicle" "attack"
		{0		15}
	}
	{"vehicle" "visible"
		{0		20}
	}

; // Human detection range

	{"human" "attack"
		{0		2}
		{80		2}
		{82		0}
	}
	{"human" "visible"
		{0		2}
	}
	{"animal" "visible"
		{0		15}
	}
}
