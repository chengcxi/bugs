; DSL 			GEM ENGINE 2 Gates of Hell
; Version:		2.1
; Description: Основной механизм авиации с фильтрацией по эрам, отдельным вызовом транспортников и таймером исчезновения.

;---------------------------------------- 1. dcg/def_team
			{"dcg/def_team"
				{condition
					{terms
						{"1.event"
							{id "dcg"}
						}
						{"2.cmp_i"
							{var "user_team$"}
							{op ">"}
							{value 0}
						}
						{"3.cmp_i"
							{var "enemyid$"}
							{op ">"}
							{value 0}
						}
					}
				}
				{actions
					{"delay"
						{time 0.5}
					}
					{"switch"
						{"case"
							{condition
								{type cmp_i}
								{var "user_is_defender$"}
								{op "=="}
								{value 1}
							}
							{"delay"
								{time 0.1}
							}
							{"delete"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag mine_planted}
											}
											{tag
												{tag dcg_mine_sign}
											}
										}
										{include
											{tag
												{tag cmp_def}
											}
										}
									}
								}
							}
						}
						{"default"}
					}
					{"delay"
						{time 0.5}
					}
					{"switch"
						{"case"
							{condition
								{type entities}
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag def_team_1}
											}
										}
										{include
											{zone
												{zone "gamezone"}
											}
										}
										{exclude
											{tag
												{tag def_team_2}
											}
											{state
												{state inactive}
											}
										}
									}
								}
							}
							{"delay"
								{time 0.1}
							}
							{"set_i"
								{var "def_team$"}
								{op "="}
								{value 1}
							}
							{"delay"
								{time 0.1}
							}
							{"delete"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag mine_planted}
											}
											{tag
												{tag dcg_mine_sign}
											}
										}
										{include
											{tag
												{tag cmp_def}
											}
											{state
												{state inactive}
											}
										}
									}
								}
							}
						}
						{"case"
							{condition
								{type entities}
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag def_team_2}
											}
										}
										{include
											{zone
												{zone "gamezone"}
											}
										}
										{exclude
											{tag
												{tag def_team_1}
											}
											{state
												{state inactive}
											}
										}
									}
								}
							}
							{"delay"
								{time 0.1}
							}
							{"set_i"
								{var "def_team$"}
								{op "="}
								{value 2}
							}
						}
						{"default"
							{"delay"
								{time 0.1}
							}
							{"set_i"
								{var "def_team$"}
								{op "="}
								{value "user_team$"}
							}
						}
					}
					{"delay"
						{time 1}
					}
					{"switch"
						{"case"
							{condition
								{type entities}
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag "1_a_2-3"}
											}
											{tag
												{tag "2_a_2-3"}
											}
											{tag
												{tag "3_a_2-3"}
											}
											{tag
												{tag "4_a_2-3"}
											}
											{tag
												{tag "5_a_2-3"}
											}
										}
										{include
											{zone
												{zone "combat"}
											}
										}
										{exclude
											{tag
												{tag hidden}
											}
											{state
												{state inactive}
											}
										}
									}
								}
							}
							{"delay"
								{time 0.1}
							}
							{"set_i"
								{var "tier2$"}
								{op "="}
								{value 1}
							}
						}
						{"default"}
					}
					{"delay"
						{time 0.5}
					}
					{"switch"
						{"case"
							{condition
								{type cmp_i}
								{var "tier2$"}
								{op "=="}
								{value 0}
							}
							{"delay"
								{time 0.1}
							}
							{"switch"
								{"case"
									{condition
										{type entities}
										{selector
											{source advanced}
											{ignore_captured_by_user 0}
											{group
												{select
													{tag
														{tag "1_b_2-3"}
													}
													{tag
														{tag "2_b_2-3"}
													}
													{tag
														{tag "3_b_2-3"}
													}
													{tag
														{tag "4_b_2-3"}
													}
													{tag
														{tag "5_b_2-3"}
													}
												}
												{include
													{zone
														{zone "combat"}
													}
												}
												{exclude
													{tag
														{tag hidden}
													}
													{state
														{state inactive}
													}
												}
											}
										}
									}
									{"delay"
										{time 0.1}
									}
									{"set_i"
										{var "tier2$"}
										{op "="}
										{value 1}
									}
								}
								{"default"}
							}
						}
						{"default"}
					}
					{"delay"
						{time 0.9}
					}
					{"switch"
						{"case"
							{condition
								{type cmp_i}
								{var "tier2$"}
								{op "=="}
								{value 1}
							}
						}
						{"default"
							{"delay"
								{time 0.1}
							}
							{"delete"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag mine_planted}
											}
											{tag
												{tag dcg_mine_sign}
											}
										}
										{include
											{tag
												{tag cmp_def}
											}
											{state
												{state inactive}
											}
										}
									}
								}
							}
						}
					}
					{"delay"
						{time 1}
					}
					{"delete"
						{selector
							{source advanced}
							{ignore_captured_by_user 0}
							{group
								{select
									{tag
										{tag def_team_1}
									}
									{tag
										{tag def_team_2}
									}
								}
							}
						}
					}
				}
			}			

;---------------------------------------- 2. dcg/ai_airstrike
			
			{"dcg/ai_airstrike"
				{condition
					{terms
						{"1.event" {id "ai_air_on"}}
					}
				}
				{actions
					{"delay" {time 0.1}}
					{"entity_state" {selector {ignore_captured_by_user 0} {tag enemy_air}} {tag_remove enemy_air}}
					{"delay" {time 0.1}}

					; ===== БОЕВЫЕ САМОЛЁТЫ =====
					{"switch"
						{"case"
							{condition {type cmp_i} {var "user_team$"} {op "=="} {value 1}}
							{"delay" {time 0.1}}
							{"switch"
								; ---------- 1-я эра (tier2 == 0): исключаем late_war ----------
								{"case"
									{condition {type cmp_i} {var "tier2$"} {op "=="} {value 0}}
									{"actor_to_waypoint"
										{selector
											{source advanced}
											{ignore_captured_by_user 0}
											{group
												{select
													{tag {tag airstrike_ger}}
													{tag {tag airstrike_rus}}
													{tag {tag airstrike_fin}}
													{tag {tag airstrike_usa}}
													{tag {tag airstrike_eng}}
													{tag {tag airstrike_jap}}
												}
												{include {tag {tag hidden}}}
												{exclude {tag {tag late_war}} {tag {tag disabled}}}
											}
											{amount 3}
										}
										{waypoint "0"}
										{clone}
										{approach "safe teleport & rotate"}
									}
								}
								; ---------- 2-я эра (tier2 == 1): исключаем early_war ----------
								{"default"
									{"actor_to_waypoint"
										{selector
											{source advanced}
											{ignore_captured_by_user 0}
											{group
												{select
													{tag {tag airstrike_ger}}
													{tag {tag airstrike_rus}}
													{tag {tag airstrike_fin}}
													{tag {tag airstrike_usa}}
													{tag {tag airstrike_eng}}
													{tag {tag airstrike_jap}}
												}
												{include {tag {tag hidden}}}
												{exclude {tag {tag early_war}} {tag {tag disabled}}}
											}
											{amount 4}
										}
										{waypoint "0"}
										{clone}
										{approach "safe teleport & rotate"}
									}
								}
							}
						}
						{"default" ; user_team$ != 1
							{"delay" {time 0.1}}
							{"switch"
								; ---------- 1-я эра (tier2 == 0): исключаем late_war ----------
								{"case"
									{condition {type cmp_i} {var "tier2$"} {op "=="} {value 0}}
									{"actor_to_waypoint"
										{selector
											{source advanced}
											{ignore_captured_by_user 0}
											{group
												{select
													{tag {tag airstrike_ger}}
													{tag {tag airstrike_rus}}
													{tag {tag airstrike_fin}}
													{tag {tag airstrike_usa}}
													{tag {tag airstrike_eng}}
													{tag {tag airstrike_jap}}
												}
												{include {tag {tag hidden}}}
												{exclude {tag {tag late_war}} {tag {tag disabled}}}
											}
											{amount 3}
										}
										{waypoint "6"}
										{clone}
										{approach "safe teleport & rotate"}
									}
								}
								; ---------- 2-я эра (tier2 == 1): исключаем early_war ----------
								{"default"
									{"actor_to_waypoint"
										{selector
											{source advanced}
											{ignore_captured_by_user 0}
											{group
												{select
													{tag {tag airstrike_ger}}
													{tag {tag airstrike_rus}}
													{tag {tag airstrike_fin}}
													{tag {tag airstrike_usa}}
													{tag {tag airstrike_eng}}
													{tag {tag airstrike_jap}}
												}
												{include {tag {tag hidden}}}
												{exclude {tag {tag early_war}} {tag {tag disabled}}}
											}
											{amount 4}
										}
										{waypoint "6"}
										{clone}
										{approach "safe teleport & rotate"}
									}
								}
							}
						}
					}

					; ===== ТРАНСПОРТНЫЕ/ДЕСАНТНЫЕ САМОЛЁТЫ (зеркальные координаты) =====
					{"switch"
						{"case"
							{condition {type cmp_i} {var "user_team$"} {op "=="} {value 1}}
							{"actor_to_waypoint"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag {tag airstrike_ger}}
											{tag {tag airstrike_rus}}
											{tag {tag airstrike_fin}}
											{tag {tag airstrike_usa}}
											{tag {tag airstrike_eng}}
											{tag {tag airstrike_jap}}
										}
										{include
											{tag {tag hidden}}
											{tag {tag enemy_paradrop_plane}}
										}
										{exclude {tag {tag disabled}}}
									}
									{amount 3}
								}
								{waypoint "6"}
								{clone}
								{approach "safe teleport & rotate"}
							}
						}
						{"default" ; user_team$ != 1
							{"actor_to_waypoint"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag {tag airstrike_ger}}
											{tag {tag airstrike_rus}}
											{tag {tag airstrike_fin}}
											{tag {tag airstrike_usa}}
											{tag {tag airstrike_eng}}
											{tag {tag airstrike_jap}}
										}
										{include
											{tag {tag hidden}}
											{tag {tag enemy_paradrop_plane}}
										}
										{exclude {tag {tag disabled}}}
									}
									{amount 3}
								}
								{waypoint "0"}
								{clone}
								{approach "safe teleport & rotate"}
							}
						}
					}
				}
				; ===== ПРИНУДИТЕЛЬНЫЙ ВОЗВРАТ ВСЕХ САМОЛЁТОВ ЧЕРЕЗ 90 СЕКУНД =====
				{"delay" {time 180}}
				{"actor_to_waypoint"
					{selector
						{source advanced}
						{ignore_captured_by_user 0}
						{group
							{include
								{tag {tag enemy_air}}
								{state {state operatable}}
							}
						}
					}
					{waypoint "3000"}
					{approach "safe teleport & rotate"}
				}	
			}


;---------------------------------------- 3. dcg/ai_airstrike_do_mace
			
			{"dcg/ai_airstrike_do_mace"
				{condition
				{expression "1 & 2 & 3"}
					{terms
						{"1.event"
							{id "ai_air_on"}
						}
						{"2.entities"
							{selector
								{source advanced}
								{ignore_captured_by_user 0}
								{group
									{select
										{tag
											{tag enemy_air}
										}
									}
									{include
										{prop
											{prop vehicle}
										}
										{state
											{state operatable}
										}
									}
								}
							}
						}
						{"3.cmp_i"
							{var "bot_difficulty$"}
							{op ">="}										; ARm edit == - >=
							{value 3}										; Arm edit 4 - 3
						}
					}
				}
				{actions
					{"delay"
						{time 0.3}
					}
					{"entity_state"
						{selector
							{ignore_captured_by_user 0}
							{tag ai_air_target}
						}
						{tag_remove ai_air_target}
					}
					{"delay"
						{time 0.1}
					}
					{"switch"
						{"case"
							{condition
								{type cmp_i}
								{var "ai_air_on$"}
								{op "=="}
								{value 5}
							}
							{"entity_state"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag _user}
											}
										}
										{include
											{zone
												{zone "gamezone"}
											}
											{state
												{state "operatable user_control"}
											}
										}
										{exclude
											{state
												{state inactive}
											}
											{tag
												{tag destroyed}
											}
										}
									}
									{sort
										{type waypoint}
										{wpid "5"}
									}
									{amount 2}									;// ARm edit 1 - 2
								}
								{tag_add ai_air_target}
							}
						}
						{"case"
							{condition
								{type cmp_i}
								{var "ai_air_on$"}
								{op "=="}
								{value 2}
							}
							{"entity_state"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag _user}
											}
										}
										{include
											{zone
												{zone "gamezone"}
											}
											{state
												{state "operatable user_control"}
											}
										}
										{exclude
											{state
												{state inactive}
											}
											{tag
												{tag destroyed}
											}
										}
									}
									{sort
										{type waypoint}
										{wpid "2"}
									}
									{amount 1}
								}
								{tag_add ai_air_target}
							}
						}
						{"case"
							{condition
								{type cmp_i}
								{var "ai_air_on$"}
								{op "=="}
								{value 3}
							}
							{"entity_state"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag _user}
											}
										}
										{include
											{zone
												{zone "gamezone"}
											}
											{state
												{state "operatable user_control"}
											}
										}
										{exclude
											{state
												{state inactive}
											}
											{tag
												{tag destroyed}
											}
										}
									}
									{sort
										{type waypoint}
										{wpid "3"}
									}
									{amount 1}
								}
								{tag_add ai_air_target}
							}
						}
						{"case"
							{condition
								{type cmp_i}
								{var "ai_air_on$"}
								{op "=="}
								{value 4}
							}
							{"entity_state"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag _user}
											}
										}
										{include
											{zone
												{zone "gamezone"}
											}
											{state
												{state "operatable user_control"}
											}
										}
										{exclude
											{state
												{state inactive}
											}
											{tag
												{tag destroyed}
											}
										}
									}
									{sort
										{type waypoint}
										{wpid "4"}
									}
									{amount 3}									;// ARm edit 1 - 3
								}
								{tag_add ai_air_target}
							}
						}
						{"default"
							{"entity_state"
								{selector
									{source advanced}
									{ignore_captured_by_user 0}
									{group
										{select
											{tag
												{tag _user}
											}
										}
										{include
											{zone
												{zone "gamezone"}
											}
											{state
												{state "operatable user_control"}
											}
										}
										{exclude
											{state
												{state inactive}
											}
											{tag
												{tag destroyed}
											}
										}
									}
									{sort
										{type waypoint}
										{wpid "1"}
									}
									{amount 2}									;// ARm edit 1 - 2
								}
								{tag_add ai_air_target}
							}
						}
					}
					{"delay"
						{time 0.1}
					}
					{"switch"
						{"case"
							{condition
								{terms
									{"1.entities"
										{selector
											{source advanced}
											{ignore_captured_by_user 0}
											{group
												{select
													{tag
														{tag enemy_air}
													}
													{tag
														{tag cannon}
													}
												}
												{include
													{prop
														{prop vehicle}
													}
													{state
														{state inhabited}
													}
												}
											}
										}
									}
								}
								
							}
							{"air_attack"
								{selector
									{ignore_captured_by_user 0}
									{tag enemy_air}
									{tag cannon}
									{type vehicle}
									{state inhabited}
								}
								{drop "orders sensor senseless"}
								{enemies
									{ignore_captured_by_user 0}
									{tag ai_air_target}
								}
								{attack_altitude 5}
							}
						}
						{"default"
							{"air_attack"
								{selector
									{ignore_captured_by_user 0}
									{tag enemy_air}
									{type vehicle}
									{state inhabited}
								}
								{drop "orders sensor senseless"}
								{enemies
									{ignore_captured_by_user 0}
									{tag ai_air_target}
								}
								{attack_altitude 47}
							}
						}
					}
				}
			}
	

;---------------------------------------- 4. dcg/ai_airstrike_do_vanilla
	
			{"dcg/ai_airstrike_do_vanilla"
				{condition
					{expression "1 & (5 | 6 | 7) & ((2 & 4) | (3 & !4))"}
					{terms
						{"1.event"
							{id "ai_air_on"}
						}
						{"2.entities"
							{selector
								{source advanced}
								{ignore_captured_by_user 0}
								{group
									{select
										{zone 
											{zone "a_1"}
