	warning = false,
	relocating = false,
	spawning = false,
	restoring = false,
	spawned = 0,
	target = 10,
}

local ambushEventTriggered = false
local ambushWarningTimer = nil

local AMBUSH_STALL_TIMEOUT = 30 * 1000
local ambushStallTimer = nil

