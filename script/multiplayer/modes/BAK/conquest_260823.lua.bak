-- [ REWRITE ARM START ]:
-- Number of possible units that can be in a wave attack.
local WaveUnitByRoleAndDifficulty = {
	easy = {
		defender = { Min = 7, Max = 11 },
		attacker = { Min = 15, Max = 18 },
	},
	normal = {
		defender = { Min = 9, Max = 13 },
		attacker = { Min = 17, Max = 20 },
	},
	hard = {
		defender = { Min = 11, Max = 15 },
		attacker = { Min = 19, Max = 22 },
	},
	heroic = {
		defender = { Min = 13, Max = 17 },
		attacker = { Min = 21, Max = 24 },
	},
}
-- [ REWRITE ARM END ]

local function GetBotDifficultyKey()
	return BotApi.Instance.difficulty or "normal"
end

local function GetStartSpawnTime()
	return StartSpawnTime
end

local function GetSpawnCooldownTime()
	return SpawnCooldownTimeByDifficulty[GetBotDifficultyKey()] or SpawnCooldownTimeByDifficulty.normal
end

