-- Time from start of match AI will wait before attempting to buy a unit.
local StartSpawnTime = {
	-- Bot is defender
	DefenseMin = 2 * 60 * 1000, 
	DefenseMax = 3 * 60 * 1000,
	-- Bot is attacker. Controlled by preptime now. 
	AttackMin = 1 * 1000, 
	AttackMax = 1 * 1000,
}

-- Time from last purchase AI will wait before attempting to buy a new unit.
-- Values are in milliseconds.
local SpawnCooldownTimeByDifficulty = {
	easy = {
		-- Time between each wave
		DCGWaveOffMin = 1.75 * 60 * 1000,
		DCGWaveOffMax = 2.25 * 60 * 1000,

		-- Time between each spawn
		DCGMin = 2 * 1000,
		DCGMax = 2 * 1000,
	},

	normal = {
		DCGWaveOffMin = 2.00 * 60 * 1000,
		DCGWaveOffMax = 2.50 * 60 * 1000,
		-- Time between each spawn
		DCGMin = 2 * 1000,
		DCGMax = 2 * 1000,
	},

	hard = {
		DCGWaveOffMin = 2.25 * 60 * 1000,
		DCGWaveOffMax = 2.75 * 60 * 1000,
		-- Time between each spawn
		DCGMin = 2 * 1000,
		DCGMax = 2 * 1000,
	},

	heroic = {
		DCGWaveOffMin = 2.50 * 60 * 1000,
		DCGWaveOffMax = 3.00 * 60 * 1000,
		-- Time between each spawn
		DCGMin = 2 * 1000,
		DCGMax = 2 * 1000,
	},
}

