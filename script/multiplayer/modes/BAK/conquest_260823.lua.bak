function GameModeSpawnUnit(unit, maxSquadSize)
	if BotApi.Commands:SpawnAt(unit, maxSquadSize, conquestSpawnPointIndex) then
		conquestSpawnPointIndex = conquestSpawnPointIndex + 1
		return true
	end

	return false
end

