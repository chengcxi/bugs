local botDefender = false

local function isAttackerOrDefender()
	if BotApi.Conquest and BotApi.Conquest.Attacking then
		botDefender = false  -- false = atacker
	else
		botDefender = true   -- true = defender
	end

	if printDebug then
		print("Print: botDefender = " .. tostring(botDefender))
	end
end
