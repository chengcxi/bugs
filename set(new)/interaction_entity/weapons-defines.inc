(define "Automatic_Weapon"
	; Granular Head – played on EVERY shot
	{play_sound "action_recoil"}
	{play_sound "head_mid"}
	{play_sound "head_far"}
	{tags add "firing"}
	{kill_delay "burst_end"}

	{delay 0.001 "burst_end"
		{tags remove "firing"}
		; Tail – plays only when the burst is complete
		{play_sound "tail_close"}
		{play_sound "tail_mid"}
		{play_sound "tail_far"}
	}
)

(define "Automatic_Weapon_Space"
	{play_sound "%weapon_head_mid"}
	{play_sound "%weapon_head_far"}
	{tags add "firing"}
	{kill_delay "burst_end"}
	{delay 0.001 "burst_end"
		{tags remove "firing"}
		{play_sound "%weapon_tail_close"}
		{play_sound "%weapon_tail_mid"}
		{play_sound "%weapon_tail_far"}
	}
)

