		{link_sound "rotate_gun" 		"vehicle/turret/gun/gun_vertical"}
		{call "update_gun"}
	}

	{on fire "%weapon" overload
		{play_sound "MultiBarrel_action_recoil"}
		{play_sound "MultiBarrel_head_mid"}
		{play_sound "MultiBarrel_head_far"}
		{tags add "firing"}
		{delay 0.001
			{tags remove "firing"}
			{play_sound "MultiBarrel_tail_close"}
			{play_sound "MultiBarrel_tail_mid"}
			{play_sound "MultiBarrel_tail_far"}
		}
		(define "fire_barrel"
			name "%0"
				{call "fire_barrel%0"}
				{view show "flashbarrel%0"}
				{view start "flashbarrel%0"}
				{ani_play "fire%0"}
				{view start "shell%0"}
				{view start "smoke%0"}
				{delay 0.12 "shell_off"
					{view pause "shell%0"}
					{view pause "smoke%0"}
				}
				{delay 0.2 "fire"
					{view hide	"flashbarrel%0"}
					{view pause	"flashbarrel%0"}
				}
		)
		{if	("fire_barrel" args 00)
		else ("fire_barrel" args 01)
		else ("fire_barrel" args 02)
		else ("fire_barrel" args 03)
		else ("fire_barrel" args 04)
		else ("fire_barrel" args 05)
		else ("fire_barrel" args 06)
		else ("fire_barrel" args 07)
		}
	}
)

