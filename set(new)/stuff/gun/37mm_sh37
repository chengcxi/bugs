(include "/set/arm_extra_macros.inc")
; Compatibility overlay for leftover vanilla/MACE 37mm_sh37.
; ARM does not ship this gun; MACE still calls range_autocannon_37-40.

{from "pattern gun"			; "sh37"
	{filling "bulletrus_37_auto" 5} ;// 2 - 5 round clips
	{fireSound "cannon/s1/d1/Shared/Autocannon_37to40mm/"}
	{fireSoundclose "cannon/s1/3p/Shared/Autocannon_37to40mm/"}
	{reloadSound "interior/large/small_reload_interior"}
	("range_autocannon_37-40")
	{cursor "ironsights/aa"}
	{calibre 37}
	("medium_aa")
	{fillingVisible "ammo_clip"}

	("fire rate" rpm(195))
	("reload time" seconds(1.0))

	("velocity" mps(860))
	("armor health" damage(100))
	("37_slope_multipliers_800ms")

	("penetration_medium" shell(ap) range(160) a(50) b(45) c(37) d(28) e(18))
