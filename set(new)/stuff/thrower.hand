{weapon_throwing
	{inventory {noView}}
	{states
		{fire "fire"}
		{reload "reload"}
		{unload "unload"}
		{aim "aim-thrower"}
		{can_aim "can-aim-thrower"}
	}
	{foresight "Foresight2"}
	{AimingTolerance 5}			; degrees
	{aimRange 60}				; meters
	{gravity 0.8}
	{filling "throwable"}
	{thirdpersonparams inherit "human default"
		{clip
			;{distanceMin 0.1}
			{distanceMax 200}
		}
		{level 0
			{faroffset 0 11 65}
			;{nearoffset 0 15 30}
			{delta 35}
		}
		;{maxlevel 0}
	}

	;{crosshair "crosshair6"}
	;{crosshairReloading "crosshair6_reload"}
}
