;SDL

;////////////////// INSTRUCTIONS //////////////////
;Buttons go as follows, displayed in-game in this order:

; inf1       - infantry squads
; inf2       - infantry single units
; empl       - Emplacements, AA, AT, Mortars, Howitzers
; vehicles   - vehicles, armoured cars, supplies
; tanks      - main battle tanks, TDs, SPGs
; doctrine   - specific doctrine setups

; TEMP: Note all levels have been brought down to 1 to remove unit locks.
; Squads currently have an MP cost of 0 - their cost is currently calculated as the sum of their soldiers cost, see inf_jap.set
; Check ../settings.set for syntax instructions!!
; unit limits per game are not dejaped here but in gamemode presets

;user dejaped set tags that should be featured on units:
;all artillery heavyart cannon mediumcan heavycan light medium heavy infantry supply
;these tags allow player to disable certain sets for custom setups like "no heavy artillery" 
;//////////////////////////////////////////////////
;_________________________________________________
;|             inf1                               |
;|________________________________________________|

("squad_with1types_conquest" side(jap) period(late) min_stage(3) max_stage(99) name(single_officer)		c1(officer:1))
("squad_with3types_conquest" side(jap) period(late) min_stage(3) max_stage(99) name(team_officer_con) c1(rifle_sl:1) c2(officer:1) c3(rifleman_1:2))

{"squad_officer_type_95_con"
	("squad_vehicle3"		 side(jap) period(late) min_stage(3) max_stage(99) cw(3) cp(2) vehicle(type_95_car_close) crew1(officer:1) crew2(smg_1:1) crew3(medic:1)) 
}

