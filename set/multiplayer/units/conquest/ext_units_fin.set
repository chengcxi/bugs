{"81mm_krh36_mortar_barrage"
	("squad_vehicle" side(fin) period(mid)  min_stage(2) max_stage(99) cw(0) cp(0) crew(artilleryman:0) vehicle(81mm_krh36))
	{cost -350} ;81mm_krh36 cost 350 - [0] = 350
	{cost_sp 3}												;//SP	
	{cost_ap 50}											;//AP		
