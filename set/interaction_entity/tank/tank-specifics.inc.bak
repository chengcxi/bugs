		}
		{if work "fuel_tank5"
			{if tagged "fueltank_fire_count1"
        		{tags remove "fueltank_fire_count1"}
        	else tagged "fueltank_fire_count2"
                	{tags remove "fueltank_fire_count2"}
			{tags add "fueltank_fire_count1"}
        	else tagged "fueltank_fire_count3"
