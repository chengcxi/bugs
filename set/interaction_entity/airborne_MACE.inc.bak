{"a6m3_rockets_ai"
	{on "add_movement_sound" overload		;// temp until il2 gets it's own sounds
		{link_sound "engine1_start"			"vehicle/airborne/zero/zero_engine_start"}
		{link_sound "engine1_idle"			"vehicle/airborne/zero/zero_engine_idle"}
		{link_sound "engine1_full"			"vehicle/airborne/zero/zero_engine_full"}
		{link_sound "engine_accelerate"		"vehicle/airborne/zero/zero_engine_accelerate"}
		{link_sound "engine_decelerate"		"vehicle/airborne/zero/zero_engine_decelerate"}
		{link_sound "engine_stop"			"vehicle/airborne/zero/zero_engine_stop"}
		{link_sound "gear_work"				"vehicle/airborne/bf109/109_landing_gear"}
		{link_sound "bkg_plane"				"vehicle/airborne/bkg/bkg_plane_01"}
	}
	{on "add_weapon_sound" overload
		("Autocannon_s1_Rapid")
		("M45_QuadMount")
	}	
	{on spawn
		{add_view	"flash_gun_small"	"flashbarrel00"	"shooter00"}
		{add_view	"flash_gun_small"	"flashbarrel01"	"shooter01"}

		{add_view	"flash_gun_small"	"flashbarrel03"	"shooter_mg00"}
		{add_view	"flash_gun_small"	"flashbarrel04"	"shooter_mg01"}
	}
	{on fire "gun" overload
		{if  name "00"
			{view start "flashbarrel00"}
			{delay 0.2
				{view pause "flashbarrel00"}
			}
		else name "01"
			{view start "flashbarrel01"}
			{delay 0.2
				{view pause "flashbarrel01"}
			}
		}
	}
	{on fire "mgun2" overload
		{if  name "00"
			{view start "flashbarrel03"}
			{delay 0.2
				{view pause "flashbarrel03"}
			}
		else name "01"
			{view start "flashbarrel04"}
			{delay 0.2
				{view pause "flashbarrel04"}
			}
		}
	}
	{on fire "rocket" overload
		{play_sound "bkg_rocket"}
		{if operatable
			{tags add "bomb_1"}
			{delay 2
				{if tagged "bomb_1"
					{spawn "sc_jap_250" "pivot_front"}
					{bone hide "bomb_00"}
				}	
			}	
		}
	}
	{on "die"
		{bone hide "rocket00"}
		{bone hide "rocket01"}
		{bone hide "bomb_00"}
		{bone hide "pylon_rocket_r"}
		{bone hide "pylon_rocket_l"}
	}
	{on "tear_part"
		{if volume "wingr2"
			{bone hide "rocket00"}
			{bone hide "pylon_rocket_r"}
		else volume "wingl2"
			{bone hide "rocket01"}
			{bone hide "pylon_rocket_l"}
		}
	}
}

{"me_262_500x2"
	("kikka_sound")
	{on spawn
		("Autocannon_s1_Rapid")
		("tag_airborne_jet_bomber")
		("tag_airborne_ger")
		{link_sound "bkg_rocket" "weapon/shot/bkg/rocket/"}
		{add_view	"flash_gun_hmg_m2hb"	"flashbarrel00"	"shooter00"}
		{add_view	"flash_gun_hmg_m2hb"	"flashbarrel01"	"shooter01"}
		{add_view	"flash_gun_hmg_m2hb"	"flashbarrel02"	"shooter02"}
		{add_view	"flash_gun_hmg_m2hb"	"flashbarrel03"	"shooter03"}
	}
	{on "air_attack"
		{play_sound "attack"}
	}

	{on fire "gun" overload
		{if  name "00"
			{view start "flashbarrel00"}
			{delay 0.2
				{view pause "flashbarrel00"}
			}
		else name "01"
			{view start "flashbarrel01"}
			{delay 0.2
				{view pause "flashbarrel01"}
			}
		else name "02"
			{view start "flashbarrel02"}
			{delay 0.2
				{view pause "flashbarrel02"}
			}
		else name "03"
			{view start "flashbarrel03"}
			{delay 0.2
				{view pause "flashbarrel03"}
			}	
		}
	}

	{on "engine_count" overload
		{tags add "engine_count_2"}
	}

	{on "engine_start_sequence" overload
		{inherited}
		{if work "engine1"
			{delay 4.5 0.5
				{call_synced "engine2_start_sequence"}
			}
		else
			{call "engine2_start_sequence"}
		}
	}

	{on "engine1_stop_sequence" overload
		{inherited}
		{if not "engine_on"
			{call "engine2_stop_sequence"}
		}
	}

	{on "die"
			{bone hide "bomb_00"}
			{bone hide "bomb_01"}
	}

	{on "tear_part"
		{if volume "body"
			{bone hide "bomb_00"}
			{bone hide "bomb_01"}
		}
	}	
}

