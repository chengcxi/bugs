		}
	}

	{on "die"
		{bone hide "bomb_00"}
	}

	{on "tear_part"
		{if volume "body"
			{bone hide "bomb_00"}
		}
	}
}

{"a6m3_60kg"
	{on "add_movement_sound" overload		;// temp until il2 gets it's own sounds
		{link_sound "engine1_start"			"vehicle/airborne/zero/zero_engine_start"}
		{link_sound "engine1_idle"			"vehicle/airborne/zero/zero_engine_idle"}
		{link_sound "engine1_full"			"vehicle/airborne/zero/zero_engine_full"}
		{link_sound "engine_accelerate"		"vehicle/airborne/zero/zero_engine_accelerate"}
		{link_sound "engine_decelerate"		"vehicle/airborne/zero/zero_engine_decelerate"}
		{link_sound "engine_stop"			"vehicle/airborne/zero/zero_engine_stop"}
		{link_sound "gear_work"				"vehicle/airborne/bf109/109_landing_gear"}
		{link_sound "bkg_plane"				"vehicle/airborne/bkg/bkg_plane_01"}
	}
	{on "add_weapon_sound" overload
		("Autocannon_s1_Rapid")
		("M45_QuadMount")
	}	
	{on spawn
		{add_view	"flash_gun_small"	"flashbarrel00"	"shooter00"}
		{add_view	"flash_gun_small"	"flashbarrel01"	"shooter01"}

		{add_view	"flash_gun_small"	"flashbarrel03"	"shooter_mg00"}
		{add_view	"flash_gun_small"	"flashbarrel04"	"shooter_mg01"}
	}
	{on fire "gun" overload
		{if  name "00"
			{view start "flashbarrel00"}
			{delay 0.2
				{view pause "flashbarrel00"}
			}
		else name "01"
			{view start "flashbarrel01"}
			{delay 0.2
				{view pause "flashbarrel01"}
			}
		}
	}
	{on fire "mgun2" overload
		{if  name "00"
			{view start "flashbarrel03"}
			{delay 0.2
				{view pause "flashbarrel03"}
			}
		else name "01"
			{view start "flashbarrel04"}
			{delay 0.2
				{view pause "flashbarrel04"}
			}
		}
	}
	{on "die"
		{bone hide "bomb_00"}
		{bone hide "bomb_01"}
	}

	{on "tear_part"
		{if volume "body"
			{bone hide "bomb_00"}
		}
		{if volume "body"
			{bone hide "bomb_01"}
		}
	}

	{on "air_attack"
		{play_sound "attack"}
	}
}

