; (include "airborne.inc")
;/*=========== Plane Specifics MACE  ===========*/

;/*=========== Plane Defines MACE  ===========*/
(define "kikka_sound"
	{on "add_movement_sound" overload
		{link_sound "engine1_start"			"vehicle/airborne/kikka/jet_engine_kikka_start"}
		{link_sound "engine1_idle"			"vehicle/airborne/kikka/jet_engine_kikka_idle"}
		{link_sound "engine1_full"			"vehicle/airborne/kikka/jet_engine_kikka_full"}
		{link_sound "engine2_start"			"vehicle/airborne/kikka/jet_engine_kikka_start2"}
		{link_sound "engine2_idle"			"vehicle/airborne/kikka/jet_engine_kikka_idle2"}
		{link_sound "engine2_full"			"vehicle/airborne/kikka/jet_engine_kikka_full2"}
		{link_sound "engine_accelerate"		"vehicle/airborne/kikka/jet_engine_kikka_full2"}
		{link_sound "engine_decelerate"		"vehicle/airborne/kikka/jet_engine_kikka_full"}
		{link_sound "engine_stop"			"vehicle/airborne/kikka/jet_engine_kikka_stop"}
		{link_sound "gear_work"				"vehicle/airborne/bf109/109_landing_gear"}
		;{link_sound "bkg_plane"				"vehicle/airborne/bkg/bkg_plane_01"}
	}
)
;/*=========== Plane Defines MACE  ===========*/

{"ki_46_ii"
	("bf110_sound")
	{on "engine_count" overload
		{tags add "engine_count_2"}
	}

	{on "engine_start_sequence" overload
		{inherited}
		{if work "engine1"
			{delay 4.5 0.5
				{call_synced "engine2_start_sequence"}
			}
		else
			{call "engine2_start_sequence"}
		}
	}

	{on "engine1_stop_sequence" overload
		{inherited}
		{if not "engine_on"
			{call "engine2_stop_sequence"}
		}
	}
}

{"kikka"
	("kikka_sound")
	{on "add_weapon_sound" overload
		("MG15")
		("MG17")
	}
	{on fire "gun" overload
		(define "fire_barrel"
			name "%0"
				{view start "flashbarrel%0"}
				{delay 0.42
					{view pause "flashbarrel%0"}
				}
		)

		{if ("fire_barrel" args 00)
		else ("fire_barrel" args 01)
		}
	}

	{on "air_attack"
		{play_sound "attack"}
	}

	{on "engine_count" overload
		{tags add "engine_count_2"}
	}

	{on "engine_start_sequence" overload
		{inherited}
		{if work "engine1"
			{delay 4.5 0.5
				{call_synced "engine2_start_sequence"}
			}
		else
			{call "engine2_start_sequence"}
		}
	}

	{on "engine1_stop_sequence" overload
		{inherited}
		{if not "engine_on"
			{call "engine2_stop_sequence"}
		}
	}

	{on "die"
		{bone hide "bomb_00"}
	}

	{on "tear_part"
		{if volume "body"
			{bone hide "bomb_00"}
		}
	}
}

{"kikka2"
	("kikka_sound")

	{on "air_attack"
		{play_sound "attack"}
	}

	{on "engine_count" overload
		{tags add "engine_count_2"}
	}

	{on "engine_start_sequence" overload
		{inherited}
		{if work "engine1"
			{delay 4.5 0.5
				{call_synced "engine2_start_sequence"}
			}
		else
			{call "engine2_start_sequence"}
		}
	}

	{on "engine1_stop_sequence" overload
