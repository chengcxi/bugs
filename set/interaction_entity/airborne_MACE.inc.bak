{"me_262_rockets_250x2_ai"
	("kikka_sound")
	{on spawn
		("Autocannon_s1_Rapid")
		("tag_airborne_jet_bomber_ai")
		("tag_airborne_ger")
		{link_sound "bkg_rocket" "weapon/shot/bkg/rocket/"}
