{"bf110_e2_rocket"
	("bf110_sound")
	{on spawn
		("tag_airborne_hvfighter")
		("tag_airborne_ger")
	}
	{on "add_weapon_sound" overload
		("Autocannon_s1_Rapid")
		("MG15")
		("MG17")
		{link_sound "bkg_rocket" "weapon/shot/bkg/rocket/"}
	}
	{on fire "gun" overload
		(define "fire_barrel"
			name "%0"
				{view start "flashbarrel%0"}
				{delay 0.42
					{view pause "flashbarrel%0"}
				}
		)

		{if ("fire_barrel" args 00)
		else ("fire_barrel" args 01)
		}
	}

	{on fire "rocket" overload
		{play_sound "bkg_rocket"}
		{if operatable
			{tags add "bomb_1"}
			{tags add "bomb_2"}
			{delay 0.5
				{if tagged "bomb_1"
					{spawn "sc_50" "bombl1_release"}
					{bone hide "bomb00"}
					{delay 0.5
						{spawn "sc_50" "bombl2_release"}
						{bone hide "bomb01"}
					}
				}
				{delay 0.5
					{if tagged "bomb_1"
						{spawn "sc_50" "bombr1_release"}
						{bone hide "bomb02"}
						{delay 0.5
							{spawn "sc_50" "bombr1_release"}
							{bone hide "bomb03"}
						}
					}
				}		
			}	
		}
	}	

	{on "engine_count" overload
		{tags add "engine_count_2"}
	}

	{on "engine_start_sequence" overload
		{inherited}
		{if work "engine1"
			{delay 4.5 0.5
				{call_synced "engine2_start_sequence"}
			}
		else
			{call "engine2_start_sequence"}
		}
	}

	{on "engine1_stop_sequence" overload
		{inherited}
		{if not "engine_on"
			{call "engine2_stop_sequence"}
		}
	}

	{on "air_attack"
		{play_sound "attack"}
	}

	{on "die"
		{bone hide "bomb00"}
		{bone hide "bomb01"}
		{bone hide "bomb02"}
		{bone hide "bomb03"}
		{bone hide "rocket_pod"}
	}

	{on "tear_part"
		{if volume "wingr2"
			{bone hide "bomb02"}
			{bone hide "bomb03"}
		else volume "wingl2"
			{bone hide "bomb00"}
			{bone hide "bomb01"}
		}
	}
}

