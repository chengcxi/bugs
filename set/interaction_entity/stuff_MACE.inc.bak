{"stuff weapon ni_5_lunge_mine"
	{on spawn
		{volumes "body" enable select touch contact}
	}
	{on "fire"
		{stuff_detonate}
		{spawn "explosion_lunge_mine" "foresight14"}
	}
	{on contact
		{if not friendly_fire
			{if effector "tank"
				{stuff_detonate}
				{spawn "explosion_lunge_mine" "foresight14"}
			}
			{if effector "cannon"
				{stuff_detonate}
				{spawn "explosion_lunge_mine" "foresight14"}
			}
			{if effector "vehicle"
				{stuff_detonate}
				{spawn "explosion_lunge_mine" "foresight14"}
			}
		}
	}	
}

