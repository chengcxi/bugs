{"jp_konbaku_backpack"
	{on blast
		{if min_energy 1	
			{set "blast" 0}
			{delay 0.1
				{spawn "explosion" "med_backpack"}
				{delete}
			}
		else
			{set "blast" 0}
			{delay 0.1
				{spawn "explosion" "med_backpack"}
				{delete}
			}
		}
	}	
}

{"kamikaze_bomb"
	{on blast
